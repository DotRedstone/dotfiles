{
  "version": 1,
  "kind": "router",
  "settings": {
    "port": 7890, "socks-port": 7891, "redir-port": 9797, "tproxy-port": 9898,
    "allow-lan": true, "external-controller": "0.0.0.0:9090", "external-ui": "./dashboard",
    "ipv6": false, "log-level": "warning", "tcp-concurrent": true, "unified-delay": true,
    "profile": { "store-selected": true, "store-fake-ip": true },
    "tun": {
      "enable": true, "mtu": 9000, "device": "meta", "stack": "mixed",
      "dns-hijack": ["any:53", "tcp://any:53"], "auto-route": true,
      "strict-route": true, "auto-redirect": true, "auto-detect-interface": true,
      "include-android-user": [0, 10, 999], "exclude-package": [], "include-package": []
    },
    "dns": {
      "enable": true, "listen": "0.0.0.0:1053", "ipv6": false,
      "enhanced-mode": "fake-ip", "fake-ip-range": "198.18.0.1/16",
      "nameserver": ["https://8.8.8.8/dns-query", "https://1.1.1.1/dns-query"],
      "proxy-server-nameserver": ["https://223.5.5.5/dns-query"],
      "nameserver-policy": { "geosite:cn,private": ["https://223.5.5.5/dns-query"] }
    }
  }
}
