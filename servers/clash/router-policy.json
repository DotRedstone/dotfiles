    { "name": "🟦 OKX", "type": "select", "proxies": ["🌐 Default", "🇺🇸 洛杉矶", "🇸🇬 新加坡", "DIRECT"] },
    { "name": "🟨 Binance", "type": "select", "proxies": ["🌐 Default", "🇺🇸 洛杉矶", "🇸🇬 新加坡", "DIRECT"] },
    { "name": "🟪 Bybit", "type": "select", "proxies": ["🌐 Default", "🇺🇸 洛杉矶", "🇸🇬 新加坡", "DIRECT"] },
