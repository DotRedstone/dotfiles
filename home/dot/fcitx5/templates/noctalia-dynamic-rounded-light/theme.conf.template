[Metadata]
Name=fcitx5-dynamic-rounded-light
Version=2.0
Author=dot
Description="DMS-styled light rounded dynamic theme for native Wayland apps."
ScaleWithDPI=True

[InputPanel]
NormalColor={{colors.on_surface.light.hex}}
HighlightCandidateColor={{colors.on_primary_container.light.hex}}
HighlightColor={{colors.primary.light.hex}}
HighlightBackgroundColor=#00000000
EnableBlur=False
FullWidthHighlight=True
Spacing=2

[InputPanel/Background]
Image=panel.svg
Color={{colors.surface_container_high.light.hex}}
BorderColor={{colors.outline_variant.light.hex}}
BorderWidth=0

[InputPanel/Background/Margin]
Left=16
Right=16
Top=16
Bottom=16

[InputPanel/Highlight]
Image=highlight.svg
Color={{colors.primary_container.light.hex}}
BorderColor={{colors.primary_container.light.hex}}
BorderWidth=0

[InputPanel/Highlight/Margin]
Left=12
Right=12
Top=12
Bottom=12

[InputPanel/ContentMargin]
Left=8
Right=8
Top=7
Bottom=7

[InputPanel/TextMargin]
Left=10
Right=10
Top=5
Bottom=5

[Menu]
NormalColor={{colors.on_surface.light.hex}}
HighlightCandidateColor={{colors.on_primary_container.light.hex}}
Spacing=2

[Menu/Background]
Image=panel.svg
Color={{colors.surface_container_high.light.hex}}
BorderColor={{colors.outline_variant.light.hex}}
BorderWidth=0

[Menu/Background/Margin]
Left=16
Right=16
Top=16
Bottom=16

[Menu/Highlight]
Image=highlight.svg
Color={{colors.primary_container.light.hex}}
BorderColor={{colors.primary_container.light.hex}}
BorderWidth=0

[Menu/Highlight/Margin]
Left=12
Right=12
Top=12
Bottom=12

[Menu/ContentMargin]
Left=8
Right=8
Top=7
Bottom=7

[Menu/TextMargin]
Left=8
Right=8
Top=5
Bottom=5
