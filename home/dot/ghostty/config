# ---
# Module: Ghostty Configuration
# Description: 试用期配置，视觉与 WezTerm 的 visuals/ui/theme 模块对齐
# Scope: Home Manager
# ---

# [Font]
# 与 wezterm/modules/visuals.lua 的字体栈和字号保持一致
font-family = Maple Mono NF
font-family = Noto Sans CJK SC
font-family = Symbols Nerd Font Mono
font-size = 12

# [Theme]
# 由 desktop-shells/dms.nix 的 ghostty_noctalia 模板生成，与 WezTerm 的
# colors/Noctalia.toml 取自同一组颜色令牌。主题缺失时 Ghostty 只告警不退出。
theme = Noctalia

# [Window Chrome]
# 对齐 ui.lua：window_decorations = "NONE"、enable_tab_bar = false，
# 以及 left/right 1cell、top/bottom 0.5cell 的内边距（按 12pt 字宽换算像素）。
window-decoration = false
gtk-tabs-location = hidden
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
background-opacity = 1

# [Selection]
# 选中即写入剪贴板。WezTerm 默认把选区写进 primary selection（中键粘贴），
# Ghostty 默认 copy-on-select = none，所以换过来会感觉「选中没复制」。
# both：同时写 primary 和 clipboard，Ctrl+V 与中键都能立刻用；
# 只想要原来的中键行为就改成 primary。
copy-on-select = both

# [Cursor]
# 对齐 visuals.lua 的 BlinkingBar + cursor_thickness = "2pt"。
# adjust-cursor-thickness 是在字体原始值上增减的像素数，不是绝对值；
# 觉得还细就调到 3 或 4，想更细回到 1。
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 2

# [Scroll]
# precision 对应触控板等像素精度设备，discrete 对应滚轮。
# 验收滚动是否顺滑时主要看 precision 这一项：1 表示严格跟随像素增量，
# 可以在行中间停住；discrete 的 3 是每格行数，觉得快就调小。
mouse-scroll-multiplier = precision:1,discrete:3
scrollback-limit-lines = unlimited
scrollbar = system

# [Input]
# 关闭输入时自动回到底部，阅读历史输出时不被打断。
scroll-to-bottom = keystroke
