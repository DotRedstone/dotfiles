[Metadata]
Name=fcitx5-dynamic-rounded-dark
Version=2.2
Author=dot
Description="DMS-styled pill-shaped dark dynamic theme for native Wayland apps."
ScaleWithDPI=True

[InputPanel]
NormalColor={{colors.on_surface.dark.hex}}
HighlightCandidateColor={{colors.on_primary_container.dark.hex}}
HighlightColor={{colors.primary.dark.hex}}
HighlightBackgroundColor=#00000000
EnableBlur=False
FullWidthHighlight=False
PageButtonAlignment=Center
Spacing=2

[InputPanel/Background]
Image=panel.svg
Color={{colors.surface_container_high.dark.hex}}
BorderColor={{colors.outline_variant.dark.hex}}
BorderWidth=0

[InputPanel/Background/Margin]
Left=21
Right=21
Top=18
Bottom=18

[InputPanel/Highlight]
Image=highlight.svg
Color={{colors.primary_container.dark.hex}}
BorderColor={{colors.primary_container.dark.hex}}
BorderWidth=0

[InputPanel/Highlight/Margin]
Left=15
Right=15
Top=11
Bottom=11

[InputPanel/ContentMargin]
Left=6
Right=6
Top=5
Bottom=5

[InputPanel/TextMargin]
Left=11
Right=11
Top=5
Bottom=5

[Menu]
NormalColor={{colors.on_surface.dark.hex}}
HighlightCandidateColor={{colors.on_primary_container.dark.hex}}
Spacing=2

[Menu/Background]
Image=panel.svg
Color={{colors.surface_container_high.dark.hex}}
BorderColor={{colors.outline_variant.dark.hex}}
BorderWidth=0

[Menu/Background/Margin]
Left=21
Right=21
Top=18
Bottom=18

[Menu/Highlight]
Image=highlight.svg
Color={{colors.primary_container.dark.hex}}
BorderColor={{colors.primary_container.dark.hex}}
BorderWidth=0

[Menu/Highlight/Margin]
Left=15
Right=15
Top=11
Bottom=11

[Menu/ContentMargin]
Left=6
Right=6
Top=5
Bottom=5

[Menu/TextMargin]
Left=10
Right=10
Top=5
Bottom=5
