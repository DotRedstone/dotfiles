{
  "name": "@dot/edge-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm test",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "clash:urls": "node scripts/show-clash-profile-urls.mjs",
    "dev": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^24.3.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
