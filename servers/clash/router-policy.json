{
  "port": 7890,
  "socks-port": 7891,
  "allow-lan": true,
  "mode": "rule",
  "log-level": "info",
  "ipv6": false,
  "unified-delay": true,
  "tcp-concurrent": true,
  "profile": {
    "store-selected": true,
    "store-fake-ip": true
  },
  "dns": {
    "enable": true,
    "listen": "0.0.0.0:1053",
    "ipv6": false,
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",
    "nameserver": [
      "https://dns.google/dns-query",
      "https://cloudflare-dns.com/dns-query"
    ],
    "proxy-server-nameserver": ["223.5.5.5", "119.29.29.29"],
    "nameserver-policy": {
      "geosite:cn,private": [
        "https://223.5.5.5/dns-query",
        "https://119.29.29.29/dns-query"
      ]
    }
  },
  "proxies": [],
  "proxy-providers": {
    "VPS-Node-LA-Reality": {
      "type": "http",
      "interval": 86400,
      "health-check": { "enable": true, "url": "https://www.gstatic.com/generate_204", "interval": 300 }
    },
    "VPS-Node-LA-WS": {
      "type": "http",
      "interval": 86400,
      "health-check": { "enable": true, "url": "https://www.gstatic.com/generate_204", "interval": 300 }
    },
    "VPS-Node-LA-Preferred": {
      "type": "http",
      "interval": 86400,
      "health-check": { "enable": true, "url": "https://www.gstatic.com/generate_204", "interval": 300 }
    },
    "VPS-Node-SG-Reality": {
      "type": "http",
      "interval": 86400,
      "health-check": { "enable": true, "url": "https://www.gstatic.com/generate_204", "interval": 300 }
    },
    "VPS-Node-SG-WS": {
      "type": "http",
      "interval": 86400,
      "health-check": { "enable": true, "url": "https://www.gstatic.com/generate_204", "interval": 300 }
    },
    "VPS-Node-SG-Preferred": {
      "type": "http",
      "interval": 86400,
      "health-check": { "enable": true, "url": "https://www.gstatic.com/generate_204", "interval": 300 }
    }
  },
  "proxy-groups": [
    {
      "name": "♻️ 洛杉矶-直连-自动",
      "type": "url-test",
      "url": "https://www.gstatic.com/generate_204",
      "interval": 300,
      "tolerance": 50,
      "use": ["VPS-Node-LA-Reality", "VPS-Node-LA-WS"]
    },
    {
      "name": "🇺🇸 洛杉矶-直连-手动",
      "type": "select",
      "use": ["VPS-Node-LA-Reality", "VPS-Node-LA-WS"]
    },
    {
      "name": "♻️ 洛杉矶-优选-自动",
      "type": "url-test",
      "url": "https://www.gstatic.com/generate_204",
      "interval": 300,
      "tolerance": 50,
      "filter": "LA-CF",
      "use": ["VPS-Node-LA-Preferred"]
    },
    {
      "name": "🇺🇸 洛杉矶-优选-手动",
      "type": "select",
      "filter": "LA-CF",
      "use": ["VPS-Node-LA-Preferred"]
    },
    {
      "name": "🇺🇸 洛杉矶",
      "type": "select",
      "proxies": [
        "♻️ 洛杉矶-直连-自动",
        "🇺🇸 洛杉矶-直连-手动",
        "♻️ 洛杉矶-优选-自动",
        "🇺🇸 洛杉矶-优选-手动"
      ]
    },
    {
      "name": "♻️ 新加坡-直连-自动",
      "type": "url-test",
      "url": "https://www.gstatic.com/generate_204",
      "interval": 300,
      "tolerance": 50,
      "use": ["VPS-Node-SG-Reality", "VPS-Node-SG-WS"]
    },
    {
      "name": "🇸🇬 新加坡-直连-手动",
      "type": "select",
      "use": ["VPS-Node-SG-Reality", "VPS-Node-SG-WS"]
    },
    {
      "name": "♻️ 新加坡-优选-自动",
      "type": "url-test",
      "url": "https://www.gstatic.com/generate_204",
      "interval": 300,
      "tolerance": 50,
      "filter": "SG-CF",
      "use": ["VPS-Node-SG-Preferred"]
    },
    {
      "name": "🇸🇬 新加坡-优选-手动",
      "type": "select",
      "filter": "SG-CF",
      "use": ["VPS-Node-SG-Preferred"]
    },
    {
      "name": "🇸🇬 新加坡",
      "type": "select",
      "proxies": [
        "♻️ 新加坡-直连-自动",
        "🇸🇬 新加坡-直连-手动",
        "♻️ 新加坡-优选-自动",
        "🇸🇬 新加坡-优选-手动"
      ]
    },
    {
      "name": "🌐 Default",
      "type": "select",
      "proxies": ["🇺🇸 洛杉矶", "🇸🇬 新加坡", "DIRECT"]
    },
    { "name": "🤖 ChatGPT", "type": "select", "proxies": ["🌐 Default", "🇺🇸 洛杉矶", "🇸🇬 新加坡", "DIRECT"] },
    { "name": "🧠 AI", "type": "select", "proxies": ["🌐 Default", "🇺🇸 洛杉矶", "🇸🇬 新加坡", "DIRECT"] },
