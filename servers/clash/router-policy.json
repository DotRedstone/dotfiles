    { "name": "🍎 Apple", "type": "select", "proxies": ["🌐 Default", "DIRECT", "🇺🇸 洛杉矶", "🇸🇬 新加坡"] },
    { "name": "🔎 Google", "type": "select", "proxies": ["🌐 Default", "🇺🇸 洛杉矶", "🇸🇬 新加坡", "DIRECT"] },
    { "name": "🪟 Microsoft", "type": "select", "proxies": ["DIRECT", "🌐 Default", "🇺🇸 洛杉矶", "🇸🇬 新加坡"] },
    { "name": "☁️ cloudflare", "type": "select", "proxies": ["🌐 Default", "🇺🇸 洛杉矶", "🇸🇬 新加坡", "DIRECT"] },
    { "name": "🎮 Steam", "type": "select", "proxies": ["🌐 Default", "DIRECT", "🇺🇸 洛杉矶", "🇸🇬 新加坡"] },
    { "name": "🚝 测速工具", "type": "select", "proxies": ["🌐 Default", "DIRECT", "🇺🇸 洛杉矶", "🇸🇬 新加坡"] },
